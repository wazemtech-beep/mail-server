# ==============================================================================
# AETHERMAIL CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================

# Database Connection (Aiven Cloud PostgreSQL)
# When set, AetherMail automatically connects to Aiven and runs cloud migrations.
# When empty, AetherMail uses local SQLite (mailserver.db) for development.
DATABASE_URL=postgres://avnadmin:password@host.aivencloud.com:port/defaultdb?sslmode=require

# Resend API Key (Used for Outbound Relay & Inbound Content Fetching)
RESEND_API_KEY=re_TUnmKbsN_9G6MGivYpJqjVAZK5haPnfg1

# Resend Svix Webhook Signing Secret (From Resend Dashboard -> Webhooks -> Signing Secret)
RESEND_WEBHOOK_SECRET=whsec_your_secret_key_here

# Public Webhook Base URL
PUBLIC_BASE_URL=https://mail.wazemtech.com

# Server Networking
PORT=3000
SMTP_PORT=2525
HOST=127.0.0.1
